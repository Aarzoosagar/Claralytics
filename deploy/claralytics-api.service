[Unit]
Description=Claralytics FastAPI backend
After=network.target

[Service]
Type=simple
# Change these two if you deploy under a different user/path
User=ubuntu
WorkingDirectory=/home/ubuntu/claralytics/backend
EnvironmentFile=/home/ubuntu/claralytics/backend/.env
ExecStart=/home/ubuntu/claralytics/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
